# FR-2 reverse image search — each is optional; the pipeline degrades to whichever
# key is present rather than failing the check.
GOOGLE_APPLICATION_CREDENTIALS=   # service account json for Vision Web Detection
AZURE_BING_VISUAL_SEARCH_KEY=     # see src/search.py on the Bing API retirement

# FR-7 classifier
HF_MODEL=Organika/sdxl-detector   # license is checked at call time, not assumed
HF_TOKEN=                         # needed for the inference API / gated models

# FR-8 VLM anomaly pass
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# NFR-1 cost control
MAX_COST_PER_CHECK_USD=0.05
MAX_CANDIDATE_URLS=10
COST_VISION_CALL=0.0035
COST_BING_CALL=0.0070
COST_VLM_CALL=0.0020
